# Opcional. Necessário apenas para ativar o botão "Aprofundar com IA" na aba
# Assistente. Sem essa variável, o app funciona normalmente e o botão retorna
# um aviso de indisponibilidade em vez de quebrar.
# Configure em: Vercel -> Project Settings -> Environment Variables.
ANTHROPIC_API_KEY=

# Opcional. Necessário apenas para ativar a Sincronização (botão
# "Sincronizar" no topo do app), que permite ver os mesmos dados em vários
# dispositivos/navegadores usando um código em comum. Sem essas variáveis,
# o app funciona normalmente em modo local (dados só no dispositivo).
# Crie um banco em Vercel -> Storage -> Create Database -> Upstash for
# Redis: essa integração já preenche KV_REST_API_URL e KV_REST_API_TOKEN
# automaticamente nas variáveis de ambiente do projeto. Se preferir criar
# o banco diretamente em upstash.com, use UPSTASH_REDIS_REST_URL /
# UPSTASH_REDIS_REST_TOKEN (também aceitos).
KV_REST_API_URL=
KV_REST_API_TOKEN=
